# ─────────────────────────────────────────────────────────────────────────────
# Caddyfile
# Handles automatic SSL provisioning via Let's Encrypt and reverse proxies
# traffic to the Next.js frontend and FastAPI backend.
# ─────────────────────────────────────────────────────────────────────────────

# The domain name will be injected via an environment variable.
# For local testing without a domain, you can set DOMAIN=localhost
{$DOMAIN} {
    # ── Proxy all requests to Next.js (Next.js proxies /api to FastAPI internally) ──
    handle {
        reverse_proxy http://nextjs:3000
    }

    # ── Compression ───────────────────────────────────────────────────────────
    encode zstd gzip
}
